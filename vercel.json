{
  "version": 2,
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/index.php",
      "use": "vercel-php"
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/admin-manifest.json", "destination": "/admin-manifest.json" },
    { "source": "/build/(.*)", "destination": "/build/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/api/(.*)", "destination": "/api/index.php" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "env": {
    "PHP_VERSION": "8.3",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_STORE": "file",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "array"
  }
}
